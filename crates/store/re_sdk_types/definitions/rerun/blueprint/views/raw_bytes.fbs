namespace rerun.blueprint.views;

/// A view of a single binary piece of data, for use with [archetypes.RawBytes].
table RawBytesView (
    "attr.rerun.view_identifier": "RawBytes"
) {

  // TODO(rrad5409): can these be part of the visualizer not the view system?

  /// Query for raw bytes view
  query: rerun.blueprint.archetypes.RawBytesQuery (order: 100);
}


/// A chunk of raw bytes.
table RawBytes (
  "attr.docs.category": "Other",
  "attr.docs.view_types": "RawBytesView",
  "attr.rerun.state": "unstable",
  "attr.rerun.visualizer": "RawBytes",
  "attr.rust.derive": "PartialEq"
) {
  /// Raw binary data.
  blob: rerun.components.Blob ("attr.rerun.component_required", order: 100);
}

